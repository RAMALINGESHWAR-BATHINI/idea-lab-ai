# =============================================================================
# IdeaLab AI — backend configuration (copy to backend/.env and edit)
# Never commit the real .env file.
# =============================================================================

# ---- Application ----
APP_NAME=IdeaLab AI
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# ---- Security ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true

# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (PostgreSQL 16 + pgvector ONLY) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/idealab
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Gemini (public-world reasoning + live voice) ----
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_THINKING_MODEL=gemini-3.8-live-extended-thinking
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_VERIFY_MODELS_ON_START=true

# ---- Ollama (local / private inference + embeddings) ----
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Embeddings ----
# "ollama" keeps private data on-prem; "gemini" sends text to Google.
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSION=768

# ---- Web intelligence / fetching ----
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5000000
FETCH_MAX_REDIRECTS=3
WEB_SEARCH_RESULTS=5
SSRF_ALLOW_PRIVATE_HOSTS=false

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_VOICE=20/minute

# ---- Memory ----
MEMORY_MAX_ITEMS_PER_USER=500
CONVERSATION_HISTORY_LIMIT=40

# ---- Logging / audit ----
LOG_LEVEL=INFO
LOG_JSON=false
AUDIT_ENABLED=true
