# Copy to .env.local (never commit). Placeholders only; frontend variables are public, so no secrets here.
# Leave VITE_API_URL empty in development: Vite proxies /api to http://127.0.0.1:8000.
# For a deployed build set the public URL of your backend API, e.g. https://api.example.org/api
VITE_API_URL=
# Where the "Voice Assistant" navigation link points (the separate voice app).
VITE_VOICE_URL=http://localhost:5174
